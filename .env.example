# =============================================================================
# CatalogIQ — Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure the values for your environment.
# Never commit real credentials or .env files to source control.

# --- Application Settings ---
APP_NAME=CatalogIQ
ENV=development
PORT=8000

# --- Database Configurations (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catalogiq
# For Docker Compose:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/catalogiq

# --- Redis Configuration ---
# Used for Celery background job distribution and task state tracking
REDIS_URL=redis://localhost:6379/0
# For Docker Compose:
# REDIS_URL=redis://redis:6379/0

# --- Qdrant Vector Database ---
# Used for semantic search and neural product embeddings
QDRANT_URL=http://localhost:6333
# For Docker Compose:
# QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=catalogiq_products

# --- File Storage Configuration ---
# Options: local | s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage

# S3 Configuration (only used if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=catalogiq-products
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_REGION=us-east-1

# --- LLM Provider Configuration ---
# Options: ollama (local development) | gemini (production) | mock (unit tests only)
LLM_PROVIDER=gemini

# Google Gemini Configuration
# Requires google-genai SDK (pip install google-genai)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Ollama Configuration (Local development fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_RETRIES=1
OLLAMA_KEEP_ALIVE=30m

# --- Vector Embedding Model ---
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=text-embedding-3-small

# --- Pipeline Versioning ---
EXTRACTION_PROMPT_VERSION=v1.0
EXTRACTION_SCHEMA_VERSION=v1
PIPELINE_VERSION=v1

# --- Worker & Quality Gate Thresholds ---
WORKER_CONCURRENCY=4
MAX_UPLOAD_SIZE_MB=50
CONFIDENCE_THRESHOLD_HIGH=85
CONFIDENCE_THRESHOLD_MEDIUM=60
