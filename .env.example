# =============================================================================
# CatalogIQ — Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit real credentials, API keys, or production secrets to source control.

# -----------------------------------------------------------------------------
# 1. Application & Network Settings
# -----------------------------------------------------------------------------
APP_NAME=CatalogIQ
# Options: development | production | test
ENV=production
# Render automatically injects $PORT (default: 10000 on Render, 8000 local)
PORT=8000

# CORS Allowed Origins
# For development: "*" or "http://localhost:5173,http://localhost:3000"
# For production: comma-separated list of deployed frontend URLs
# Example: https://catalogiq.vercel.app,https://catalogiq-app.vercel.app
CORS_ORIGINS=https://catalogiq.vercel.app,http://localhost:5173

# -----------------------------------------------------------------------------
# 2. Database Configurations (Managed PostgreSQL)
# -----------------------------------------------------------------------------
# Managed PostgreSQL connection string (Render PostgreSQL, Supabase, Neon, AWS RDS)
# Note: Both postgresql:// and postgres:// formats are supported and auto-normalized.
DATABASE_URL=postgresql://catalogiq_user:password@dpg-xxxx.render.com/catalogiq_db

# Local development / Docker Compose fallback:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/catalogiq

# -----------------------------------------------------------------------------
# 3. Redis Configuration (Cache & Celery Task Broker)
# -----------------------------------------------------------------------------
# Managed Redis connection string (Render Redis, Upstash, Redis Cloud)
# Supports rediss:// for TLS-encrypted connections.
REDIS_URL=rediss://default:password@red-xxxx.render.com:6379

# Local development / Docker Compose fallback:
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# 4. Qdrant Vector Database (Qdrant Cloud / Managed Vector Search)
# -----------------------------------------------------------------------------
# Qdrant Cloud cluster endpoint and API Key
QDRANT_URL=https://xxxxxx-xxxx-xxxx.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_COLLECTION_NAME=catalogiq_products

# Local development / Docker Compose fallback:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# 5. File & Object Storage Configuration
# -----------------------------------------------------------------------------
# Options: s3 (Production Object Storage) | local (Local Disk Development)
# IMPORTANT: In production on Render (where containers have ephemeral disks and
# web service & Celery worker run in separate containers), STORAGE_PROVIDER must
# be set to "s3" with AWS S3, Cloudflare R2, Supabase Storage, or MinIO.
STORAGE_PROVIDER=s3
LOCAL_STORAGE_DIR=./storage

# S3-Compatible Object Store Settings (AWS S3, Cloudflare R2, MinIO, Supabase)
AWS_ACCESS_KEY_ID=your_aws_or_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_or_r2_secret_access_key
S3_BUCKET_NAME=catalogiq-production-storage
# S3 Endpoint URL (e.g. AWS standard or Cloudflare R2 endpoint)
# AWS S3 standard: https://s3.us-east-1.amazonaws.com
# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# 6. LLM Intelligence Provider Configuration
# -----------------------------------------------------------------------------
# Options: gemini (Production) | ollama (Local development) | mock (Unit tests)
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Production)
# API key obtained from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ollama Configuration (Local development fallback only)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_RETRIES=1
OLLAMA_KEEP_ALIVE=30m

# -----------------------------------------------------------------------------
# 7. Neural Embeddings Model
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# 8. Extraction Versioning & Pipeline Safety
# -----------------------------------------------------------------------------
# Modifying any of these version tokens invalidates cached extraction outputs.
EXTRACTION_PROMPT_VERSION=v1.0
EXTRACTION_SCHEMA_VERSION=v1
PIPELINE_VERSION=v1

# -----------------------------------------------------------------------------
# 9. Worker Concurrency & Upload Limits
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=4
MAX_UPLOAD_SIZE_MB=50

# Archive safety limits (ZIP unpacking)
MAX_ARCHIVE_SIZE_MB=50
MAX_ARCHIVE_EXTRACTED_SIZE_MB=200
MAX_ARCHIVE_FILES=100
MAX_ARCHIVE_FILE_SIZE_MB=50

# Quality Gate Confidence Thresholds (0.00 to 1.00)
CONFIDENCE_THRESHOLD_HIGH=0.85
CONFIDENCE_THRESHOLD_MEDIUM=0.60
